<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyMvcApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Light gray background to make white cards pop */
        body { background-color: #f8f9fa; } 
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark shadow-sm mb-4 py-3">
            <div class="container">
                <a class="navbar-brand fw-bold text-uppercase tracking-wide" href="/">
                    📚 MyMvcApp
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Library/Books">Books Directory</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav flex-grow-1 ms-3">
    <li class="nav-item">
        <a class="nav-link" href="/">Home</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="/Library/Books">Books Directory</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-warning fw-semibold" href="/swagger" target="_blank">⚡ Swagger API UI</a>
    </li>
</ul>
                    <!-- Injects the Login/Register buttons -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Modern Footer with IUST Branding -->
    <footer class="bg-white border-top py-4 shadow-sm mt-auto">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="text-muted fw-semibold">&copy; 2024 - MyMvcApp</span>
            <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm rounded-pill">IUST Full Stack Lab</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>