@model MyMvcApp.Models.Book
<h2>Add a Book</h2>
<form asp-action="Create" method="post">
<!-- Global summary for form-level errors -->
<div asp-validation-summary="ModelOnly" class="text-danger
mb-3"></div>
<div class="mb-3">
<label asp-for="Title"></label>
<input asp-for="Title" class="form-control" />
<!-- Displays the specific error message for Title -->
<span asp-validation-for="Title"
class="text-danger"></span>
</div>
<div class="mb-3">
<label asp-for="Author"></label>
<input asp-for="Author" class="form-control" />
<!-- Displays the specific error message for Author -->
<span asp-validation-for="Author"
class="text-danger"></span>
</div>
<button type="submit" class="btn btn-success">Save</button>
</form>
<!-- This script section enables fast client-side (JavaScript)
validation -->
@section Scripts {
@{await
Html.RenderPartialAsync("_ValidationScriptsPartial");}
}